      </column>
      <column caption='delay control' datatype='real' name='[Calculation_213921044470173705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Delay (Avarage Time)&apos; THEN AVG([DELAY_MINUTES])&#13;&#10;WHEN  &apos;Delay (Total Sum)&apos; THEN SUM([DELAY_MINUTES])&#13;&#10;END' />
