      </column>
      <column caption='Avg Security Delay' datatype='real' name='[Calculation_213921044461043717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IFNULL([SECURITY_DELAY],0))' />
      </column>
      <column caption='Avg Airline Delay' datatype='real' name='[Calculation_213921044461142022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IFNULL([AIRLINE_DELAY],0))' />
      </column>
      <column caption='Avg Late Aircraft Delay' datatype='real' name='[Calculation_213921044461240327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IFNULL([LATE_AIRCRAFT_DELAY],0))' />
