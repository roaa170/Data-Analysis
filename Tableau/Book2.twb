      <column caption='Cancellation Reason Description' datatype='string' name='[Calculation_213921044445159424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CANCELLATION_REASON] = &apos;A&apos; THEN &apos;Air System&apos;&#13;&#10;ELSEIF [CANCELLATION_REASON] = &apos;B&apos; THEN &apos;Weather&apos;&#13;&#10;ELSEIF [CANCELLATION_REASON] = &apos;C&apos; THEN &apos;Airline&apos;&#13;&#10;ELSEIF [CANCELLATION_REASON] = &apos;D&apos; THEN &apos;Security&apos;&#13;&#10;ELSE &apos;Not Cancelled&apos;&#13;&#10;END' />
      </column>
      <column caption='dounat' datatype='integer' name='[Calculation_213921044445863937]' role='measure' type='quantitative'>
